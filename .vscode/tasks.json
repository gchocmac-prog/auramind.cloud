{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Open Preview in Browser",
      "type": "shell",
      "command": "cmd",
      "args": ["/c", "start", "http://localhost:3000"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "silent" }
    },
    {
      "label": "Start Dev Server (Interactive Preview)",
      "type": "shell",
      "command": "npx",
      "args": ["wrangler@3", "dev", "--port", "3000"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "http://|localhost|Ready",
          "endsPattern": ".*"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "build"
      }
    },
    {
      "label": "Start Local Server (Fast)",
      "type": "shell",
      "command": "node",
      "args": ["serve.js"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Local:|Ready|Proxying|http://",
          "endsPattern": ".*"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "build"
      }
    },
    {
      "label": "Start Wrangler Dev (Cloudflare)",
      "type": "shell",
      "command": "npx",
      "args": ["wrangler", "dev"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Ready on|Local:",
          "endsPattern": ".*"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "build"
      }
    }
  ]
}
