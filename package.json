    "update-news": "npm run fetch-news && npm run apply-customizations",
    "build": "npm run apply-customizations",
    "serve": "node serve.js",
    "dev": "browser-sync start --server site/auramind.cloud --files \"site/auramind.cloud/**/*\" --port 3000 --open",
    "deploy": "wrangler deploy",
